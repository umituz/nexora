{
  "name": "nexora",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Nexora AI — unified AI workspace: conversations, projects, knowledge, memory, agents, research",
  "scripts": {
    "dev": "vite",
    "dev:api": "cf-ship dev",
    "build": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.api.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json --pretty && tsc --noEmit -p tsconfig.api.json --pretty",
    "lint": "eslint .",
    "test": "vitest run",
    "deploy": "cf-ship deploy",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx scripts/seed.ts",
    "db:snapshot": "tsx scripts/snapshot.ts",
    "db:reset": "tsx scripts/reset.ts && drizzle-kit push && tsx scripts/seed.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@umituz/web-ai": "^1.0.11",
    "@umituz/web-auth": "^2.4.1",
    "@umituz/web-dashboard": "^11.3.0",
    "@umituz/web-design-system": "^6.7.0",
    "@umituz/web-hono": "^1.19.3",
    "@umituz/web-landing": "^1.7.0",
    "@umituz/web-localization": "^1.6.1",
    "@umituz/web-seo": "^2.5.0",
    "better-auth": "^1.7.12",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "i18next": "^25.6.0",
    "i18next-browser-languagedetector": "^8.2.0",
    "lucide-react": "^1.69.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^15.1.0",
    "react-router": "^7.18.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@umituz/web-cloudflare": "^1.10.0",
    "@vitejs/plugin-react": "^6.1.2",
    "dotenv": "^18.0.8",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^16.5.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
